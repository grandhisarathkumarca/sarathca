# Copy to .env.local for local work, and set the same values in the host's build settings.
# Values are read at build time: rebuild after changing them. See README section 2.

# Production origin, no trailing slash, e.g. https://www.example.in
NEXT_PUBLIC_SITE_URL=

# Optional: overrides the WhatsApp number for the query form and buttons, digits only with country code
NEXT_PUBLIC_WHATSAPP_NUMBER=
